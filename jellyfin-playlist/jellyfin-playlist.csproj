<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- package.sh overrides these per release; they are the fallback for a plain build. -->
    <Version>1.0.2.0</Version>
    <AssemblyVersion>1.0.2.0</AssemblyVersion>
    <FileVersion>1.0.2.0</FileVersion>
    <RootNamespace>jellyfin_playlist</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="12.0.0-*" />
    <PackageReference Include="Jellyfin.Model" Version="12.0.0-*" />
    <EmbeddedResource Include="ConfigurationPage.html">
      <LogicalName>JellyfinPlaylist.ConfigurationPage.html</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
